<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 圆球录音、还有段在识别时不让屏幕灭（输入法窗口的 keepScreenOn 在三星上没生效） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Shuohuaa"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <!-- 输入法本体：屏幕上只有一个悬浮圆球 -->
        <service
            android:name=".VoiceInputService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <!-- 无障碍服务：别的键盘弹出时在它上方放一个小话筒，点了切到我们 -->
        <service
            android:name=".VoiceSwitchService"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility" />
        </service>

        <!-- 麦克风模式：把手机麦克风持续推给电脑（前台服务，通知栏可静音/停止） -->
        <service
            android:name=".MicStreamService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!-- Tasker 插件：动作 → 插件 → 我听不懂，选切换/开始/停止，不用填任何东西（TaskerPlugin） -->
        <activity
            android:name=".TaskerPluginActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tasker_plugin_label">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".TaskerPluginReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

        <!-- 下拉快捷设置里的"电脑麦克风"开关；开的时候经过透明界面再起前台服务（新版安卓不让后台开麦克风） -->
        <service
            android:name=".MicTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_pc_mic"
            android:label="@string/tile_mic"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <!-- 点"快速切换没开"通知时的中转：打开系统里本服务的开关页 -->
        <activity
            android:name=".OpenA11yActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".MicTileActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 设置页：也是启动器图标进来的地方（首次引导：启用输入法、授权麦克风） -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
